<Window x:Class="Montro.Views.PowerPointTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerPoint testen – montro"
        Width="1040" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource Brand.Window}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="VersionText" Grid.Row="0" Margin="0,0,0,12"
                   Foreground="{StaticResource Brand.SecondaryText}" Text="Verbinde mit PowerPoint …" />

        <!-- Datei -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Datei" Width="90" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Datei wählen …" Margin="8,0,0,0" Click="OnChooseFile" x:Name="ChooseButton" />
            <TextBox x:Name="FileBox" IsReadOnly="True" />
        </DockPanel>
        <TextBlock x:Name="FileDetails" Grid.Row="2" Margin="90,0,0,12" Foreground="{StaticResource Brand.SecondaryText}" />

        <!-- Bildschirm + Optionen -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="Bildschirm" Width="90" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Aktualisieren" Margin="8,0,0,0" Click="OnRefreshMonitors" />
                <ComboBox x:Name="MonitorBox" Padding="6,4" />
            </DockPanel>
            <WrapPanel Margin="90,0,0,0">
                <CheckBox x:Name="KioskBox" Content="Kiosk-Modus" />
                <CheckBox x:Name="WithWindowBox" Content="Mit Dokumentfenster öffnen" />
                <CheckBox x:Name="RegistryBox" Content="Monitor in PowerPoint vorwählen" />
            </WrapPanel>
        </StackPanel>

        <!-- Aktionen -->
        <WrapPanel Grid.Row="4" Margin="0,0,0,4">
            <Button x:Name="StartButton" Content="Show starten" Style="{StaticResource Brand.LiveButton}" Click="OnStart" />
            <Button x:Name="PrevButton" Content="◀ Zurück" Click="OnPrevious" />
            <Button x:Name="NextButton" Content="Weiter ▶" Click="OnNext" />
            <TextBox x:Name="GotoBox" Width="56" Margin="0,0,4,8" Text="1" KeyDown="OnGotoKey" />
            <Button x:Name="GotoButton" Content="Gehe zu" Click="OnGoto" />
            <Button x:Name="BlackButton" Content="Schwarz" Click="OnBlack" />
            <Button x:Name="PlaceButton" Content="Lage prüfen" Click="OnPlace" />
            <Button x:Name="StopButton" Content="Show beenden" Click="OnStop" />
            <Button x:Name="ExportButton" Content="Vorschaubilder exportieren" Click="OnExport" />
            <Button x:Name="OrphanButton" Content="Verwaiste Shows beenden" Click="OnOrphans" />
        </WrapPanel>

        <!-- Status -->
        <Border Grid.Row="5" Background="{StaticResource Brand.Panel}" BorderBrush="{StaticResource Brand.Line}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="StatusText" FontSize="22" FontWeight="SemiBold" Text="Keine Show" />
                <TextBlock x:Name="DetailText" Foreground="{StaticResource Brand.SecondaryText}" Margin="0,4,0,0" />
                <TextBlock x:Name="MessageText" Foreground="{StaticResource Brand.Warning}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ListBox x:Name="LogList" Grid.Row="6" />
    </Grid>
</Window>
