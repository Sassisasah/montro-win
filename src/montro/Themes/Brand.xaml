<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Farben nach dem Corporate Design von movidal (Mac: Core/Theme.swift).
         Alle App-Farben kommen von hier – keine Systemfarben. -->

    <!-- CD-Farben -->
    <Color x:Key="DarkMatterColor">#202020</Color>
    <Color x:Key="WhiteNoiseColor">#F5F5F5</Color>
    <Color x:Key="GraphiteWaveColor">#BBBBBB</Color>
    <Color x:Key="ShadowFlexColor">#464646</Color>
    <Color x:Key="CloudPurpleColor">#B088FB</Color>
    <Color x:Key="StaticLavenderColor">#E8DFFC</Color>
    <Color x:Key="NoirRoyaleColor">#35294B</Color>
    <Color x:Key="BassLimeColor">#B2F141</Color>
    <Color x:Key="DarkCamoColor">#314412</Color>
    <Color x:Key="LiveRedColor">#F2465A</Color>
    <Color x:Key="WarningColor">#FFB13D</Color>
    <Color x:Key="PanelColor">#2A2A2C</Color>

    <!-- Bedeutung in der App -->
    <SolidColorBrush x:Key="Brand.Background" Color="{StaticResource DarkMatterColor}" />
    <SolidColorBrush x:Key="Brand.Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Brand.Text" Color="{StaticResource WhiteNoiseColor}" />
    <SolidColorBrush x:Key="Brand.SecondaryText" Color="{StaticResource GraphiteWaveColor}" />
    <SolidColorBrush x:Key="Brand.Line" Color="{StaticResource ShadowFlexColor}" />
    <SolidColorBrush x:Key="Brand.Accent" Color="{StaticResource CloudPurpleColor}" />
    <SolidColorBrush x:Key="Brand.AccentLight" Color="{StaticResource StaticLavenderColor}" />
    <SolidColorBrush x:Key="Brand.Highlight" Color="{StaticResource NoirRoyaleColor}" />
    <SolidColorBrush x:Key="Brand.Ok" Color="{StaticResource BassLimeColor}" />
    <SolidColorBrush x:Key="Brand.OkDark" Color="{StaticResource DarkCamoColor}" />
    <SolidColorBrush x:Key="Brand.Live" Color="{StaticResource LiveRedColor}" />
    <SolidColorBrush x:Key="Brand.Warning" Color="{StaticResource WarningColor}" />

    <!-- Grund-Stile -->
    <Style TargetType="Window" x:Key="Brand.Window">
        <Setter Property="Background" Value="{StaticResource Brand.Background}" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Text}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brand.Text}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brand.Text}" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brand.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Line}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brand.Text}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Brand.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brand.SecondaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Line}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brand.Text}" />
        <Setter Property="Background" Value="{StaticResource Brand.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Line}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.Highlight}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Brand.AccentButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brand.Highlight}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Accent}" />
    </Style>

    <Style TargetType="Button" x:Key="Brand.LiveButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Brand.Live}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Live}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
